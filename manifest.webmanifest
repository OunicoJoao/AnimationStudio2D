{
  "name": "AnimationStudio 2D — desenho e animação",
  "short_name": "AnimationStudio",
  "description": "Desenhe e anime quadro a quadro com traço suave: camadas, onion skin, áudio e exportação para vídeo, GIF e PNG.",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f3f3f1",
  "theme_color": "#f3f3f1",
  "categories": ["graphics", "design", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-animationstudio2d+zip": [".as2d"] } }
  ]
}
